# ===================================================================
# TRENDUSTY ORBIT — ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env and configure your secrets locally.
# DO NOT COMMIT YOUR REAL .env FILE.
# ===================================================================

# GitHub Personal Access Token (for file sharing & repository operations)
# Required permissions: repo (read & write)
GITHUB_PAT=your_github_personal_access_token_here

# AES-256 Master Key for Encrypting/Decrypting the Account Vault (.kdbx)
ENCRYPTION_MASTER_KEY=your_64_character_hex_master_key_here

# JWT / Session Signing Secret
SECURITY_JWT_SECRET=your_jwt_signing_secret_here

# Master Admin Key to access the Account & Security Management App
ADMIN_ACCESS_KEY=your_admin_secret_key_here

# Minecraft Server Infrastructure Details
SERVER_IP=vivo-carrier.tun.ply.gg:25565
BEDROCK_PORT=19132

# EmailJS Service Configuration (optional for OTP verification)
EMAILJS_SERVICE_ID=your_emailjs_service_id
EMAILJS_TEMPLATE_ID=your_emailjs_template_id
EMAILJS_PUBLIC_KEY=your_emailjs_public_key

# Environment mode
NODE_ENV=production
