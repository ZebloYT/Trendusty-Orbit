{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "^/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "^/echonode/?$",
      "dest": "/echonode/index.html"
    },
    {
      "src": "^/echonode/(.*)",
      "dest": "/echonode/$1"
    },
    {
      "src": "^/styles\\.css$",
      "dest": "/echonode/styles.css",
      "headers": {
        "Content-Type": "text/css; charset=utf-8"
      }
    },
    {
      "src": "^/app\\.js$",
      "dest": "/echonode/app.js",
      "headers": {
        "Content-Type": "application/javascript; charset=utf-8"
      }
    },
    {
      "src": "^/three\\.min\\.js$",
      "dest": "/echonode/three.min.js",
      "headers": {
        "Content-Type": "application/javascript; charset=utf-8"
      }
    },
    {
      "src": "^/fflate\\.min\\.js$",
      "dest": "/echonode/fflate.min.js",
      "headers": {
        "Content-Type": "application/javascript; charset=utf-8"
      }
    },
    {
      "src": "^/GLTFLoader\\.js$",
      "dest": "/echonode/GLTFLoader.js",
      "headers": {
        "Content-Type": "application/javascript; charset=utf-8"
      }
    },
    {
      "src": "^/OBJLoader\\.js$",
      "dest": "/echonode/OBJLoader.js",
      "headers": {
        "Content-Type": "application/javascript; charset=utf-8"
      }
    },
    {
      "src": "^/MTLLoader\\.js$",
      "dest": "/echonode/MTLLoader.js",
      "headers": {
        "Content-Type": "application/javascript; charset=utf-8"
      }
    },
    {
      "src": "^/FBXLoader\\.js$",
      "dest": "/echonode/FBXLoader.js",
      "headers": {
        "Content-Type": "application/javascript; charset=utf-8"
      }
    },
    {
      "src": "^/echonode-cube\\.png$",
      "dest": "/echonode/echonode-cube.png"
    },
    {
      "src": "^/server-icon\\.png$",
      "dest": "/echonode/server-icon.png"
    },
    {
      "src": "^/android/?$",
      "dest": "/android/index.html"
    },
    {
      "src": "^/android/(.*)",
      "dest": "/android/$1"
    },
    {
      "src": "^/mobile/?$",
      "dest": "/android/index.html"
    },
    {
      "src": "^/m/?$",
      "dest": "/android/index.html"
    },
    {
      "src": "^/share/?$",
      "dest": "/share/index.html"
    },
    {
      "src": "^/share/shared/([^/]+)/?$",
      "dest": "/share/download.html?code=$1"
    },
    {
      "src": "^/share/shared/(.*)",
      "dest": "/share/download.html"
    },
    {
      "src": "^/share/(.*)",
      "dest": "/share/$1"
    },
    {
      "src": "^/$",
      "dest": "/home/index.html"
    },
    {
      "src": "^/home/?$",
      "dest": "/home/index.html"
    },
    {
      "src": "^/home/(.*)",
      "dest": "/home/$1"
    },
    {
      "src": "^/(.*)",
      "dest": "/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, OPTIONS"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
